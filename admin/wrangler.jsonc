{
  // Cockpit editoriale di Marco. Deploy da Cloudflare: Workers → Create → Import a repository,
  // "Root directory" = admin. Segreti e variabili si impostano nel pannello Cloudflare (vedi GUIDA.md).
  "name": "italian-next-gen-cockpit",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Le variabili TEAM_DOMAIN, POLICY_AUD, ALLOWED_EMAIL si impostano nel pannello Cloudflare (contengono la tua email):
  // keep_vars evita che ogni nuovo deploy le cancelli.
  "keep_vars": true,
  // Rebuild del sito ogni 20 minuti, 8-20 UTC (9-21 ora italiana): fa comparire gli articoli programmati
  "triggers": { "crons": ["*/20 8-19 * * *"] },
  "vars": {
    "GITHUB_REPO": "Tiri6/ItalianNextGen",
    "GITHUB_BRANCH": "main"
  }
}
